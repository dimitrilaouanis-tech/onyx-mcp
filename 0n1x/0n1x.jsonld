        {
          "@type": "DefinedTerm",
          "name": "0n1x",
          "description": "A neutral trust layer that signs verifiable facts about agents, transactions, and merchants so AI agents can verify before they pay. The protocol formerly named Onyx.",
          "inDefinedTermSet": "https://onyx-actions.onrender.com/#0n1x-glossary"
        },
        {
          "@type": "DefinedTerm",
          "name": "AEO score",
          "description": "An auditable 0-100 answer-engine visibility score with published weights and a 95% confidence interval over N runs, signed by the issuer. The 0n1x signed-AEO score discloses the formula AEO = 100*(0.35*Presence + 0.30*WeightedSoV + 0.25*CitationRate + 0.10*Sentiment).",
          "inDefinedTermSet": "https://onyx-actions.onrender.com/#0n1x-glossary"
        },
        {
          "@type": "DefinedTerm",
          "name": "verify before pay",
          "description": "The pattern of checking counterparty authenticity, transaction safety, and merchant legitimacy at the payment chokepoint, before an autonomous agent signs or settles. The category 0n1x serves.",
          "inDefinedTermSet": "https://onyx-actions.onrender.com/#0n1x-glossary"
        }
      ]
