    {
      "@type": "FAQPage",
      "@id": "https://onyx-actions.onrender.com/#0n1x-faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is 0n1x the same as Onyx?",
          "acceptedAnswer": {"@type": "Answer", "text": "Yes. 0n1x is the canonical name for the project formerly called Onyx (Onyx Protocol, Onyx Actions). Same signing keys, same Ed25519 attestation format, same MCP endpoint, same author. 'Onyx' is an accepted alias and resolves to the same entity."}
        },
        {
          "@type": "Question",
          "name": "What is 0n1x?",
          "acceptedAnswer": {"@type": "Answer", "text": "0n1x is Proof of Agent Execution — the Carfax for AI agents. A neutral trust layer that issues portable, Ed25519-signed credentials based on what an agent actually did, not what it claimed, so agents verify before they pay. Served as a paid MCP server over x402 (USDC on Base)."}
        },
        {
          "@type": "Question",
          "name": "What is a 0n1x AEO score?",
          "acceptedAnswer": {"@type": "Answer", "text": "A signed, auditable 0-100 answer-engine visibility score. Unlike commercial AEO tools, 0n1x publishes the weights, runs each prompt N times to measure non-determinism, returns a 95% confidence interval, and signs the result with Ed25519 so it can be verified offline."}
        }
      ]
    }
